# An explicit local SDK enables the embedded backend. Never fetch or search for
# a decoder on the end user's machine. Public redistribution is a separate step.
set(_xiugou_mdk_source_dir "${CMAKE_CURRENT_LIST_DIR}")
set(XIUGOU_MDK_SDK_DIR "$ENV{XIUGOU_MDK_SDK_DIR}" CACHE PATH "Optional extracted MDK SDK root (development preview)")

function(xiugou_add_mdk target)
  target_sources(${target} PRIVATE "${_xiugou_mdk_source_dir}/native_playback_mdk.cpp")
  set(sdk "${XIUGOU_MDK_SDK_DIR}")
  if(NOT sdk)
    file(TO_CMAKE_PATH "$ENV{XIUGOU_MDK_SDK_DIR}" sdk)
  endif()
  set(bundle "$<TARGET_FILE_DIR:${target}>/mdk")
  set(notice "Xiugou-MDK-SDK-notice.txt")
  if(sdk)
    if(NOT EXISTS "${sdk}/include/mdk/c/Player.h")
      message(FATAL_ERROR "XIUGOU_MDK_SDK_DIR must contain include/mdk/c/Player.h")
    endif()
    target_include_directories(${target} SYSTEM PRIVATE "${sdk}/include")
    target_compile_definitions(${target} PRIVATE XIUGOU_MDK_PREVIEW=1)
    target_link_libraries(${target} PRIVATE d3d11)
    set(runtime "${sdk}/bin/x64/mdk.dll" "${sdk}/bin/x64/ffmpeg-9.dll")
    foreach(input IN LISTS runtime)
      if(NOT EXISTS "${input}")
        message(FATAL_ERROR "Incomplete MDK Windows x64 runtime: ${input}")
      endif()
    endforeach()
    install(FILES ${runtime} DESTINATION "${bundle}" COMPONENT Runtime)
    install(FILES "${sdk}/README.md" RENAME "${notice}"
      DESTINATION "${bundle}" COMPONENT Runtime)
  else()
    # Only prune files staged by this rule when reusing an SDK-enabled build dir.
    install(CODE "if(EXISTS \"${bundle}/${notice}\")
      file(REMOVE \"${bundle}/mdk.dll\" \"${bundle}/ffmpeg-9.dll\" \"${bundle}/${notice}\")
    endif()" COMPONENT Runtime)
  endif()
endfunction()
